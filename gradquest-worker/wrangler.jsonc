{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gradquest-sop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "secrets": {
    "required": ["SOP_PROXY_SECRET"]
  },
  // remote: true keeps Durable Objects local (required) while using account AI/R2/D1/Vectorize/Browser.
  // Do not use `wrangler dev --remote` — DO SQLite is unsupported in that mode.
  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER", "remote": true },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "gradquest-sop-resume", "remote": true }
  ],
  "r2_buckets": [
    { "binding": "RESUMES", "bucket_name": "gradquest-sop", "remote": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gradquest-sop",
      "database_id": "b1b08c74-9be9-47b0-b2a4-85a9b1684222",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SopAgent", "class_name": "SopAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SopAgent"] }]
}
